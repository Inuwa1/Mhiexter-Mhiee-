{
  "entities": {
    "Memory": {
      "title": "Memory",
      "description": "A stored insight, code trick, or conversation summary.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User ID" },
        "content": { "type": "string", "description": "The stored knowledge content" },
        "createdAt": { "type": "string", "format": "date-time" },
        "tags": { "type": "array", "description": "Array of tags" }
      },
      "required": ["uid", "content", "createdAt"]
    }
  },
  "firestore": {
    "/memories/{memoryId}": {
      "schema": "Memory",
      "description": "User insights and knowledge base"
    }
  }
}
