{
  "entities": {
    "UserFace": {
      "title": "UserFace",
      "description": "Stores user face images for personalized generation.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user's unique ID." },
        "faceImage": { "type": "string", "description": "Base64 encoded face image." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of creation." }
      },
      "required": ["uid", "faceImage", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}/faces/{faceId}": {
      "schema": { "$ref": "UserFace" },
      "description": "User's stored face images."
    }
  }
}
